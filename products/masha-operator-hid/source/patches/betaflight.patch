@@ -59,6 +65,126 @@ const uint8_t hidChannelMapping[] = {
     AUX12     // Button 8
 };
 
+#ifdef USE_MASHA_OPERATOR_KEYBOARD
+#define OPERATOR_FRAME_SIZE 4
+#define OPERATOR_FRAME_MAGIC 0xA5
+#define OPERATOR_KEY_MIN 0x04
+#define OPERATOR_KEY_MAX 0x38
+#define OPERATOR_MODIFIERS_ALLOWED 0x07
+#define OPERATOR_REPORT_HOLD_MS 30
+
+typedef enum {
+    OPERATOR_KEY_IDLE = 0,
+    OPERATOR_KEY_PRESSED,
+    OPERATOR_KEY_RELEASED
+} operatorKeyState_e;
+
+// UART4 — отдельный канал команд, который открывается только если порт свободен.
+static serialPort_t *operatorSerialPort;
+// Буфер кадра A5, модификатор, HID usage, XOR checksum.
+static uint8_t operatorFrame[OPERATOR_FRAME_SIZE];
+// Число принятых байтов текущего кадра.
+static uint8_t operatorFrameLength;
+// Состояние двух отчётов нажатия/отпускания; каждый держится дольше USB poll interval.
+static operatorKeyState_e operatorKeyState;
+// Момент следующего разрешённого перехода состояния HID.
+static timeMs_t operatorKeyDeadline;
+// Буфер стандартного восьмибайтового USB boot-keyboard отчёта.
+static uint8_t operatorKeyboardReport[8];
+
+// Отправляет короткое подтверждение ноутбуку по UART4.
+static void operatorSendAck(const char *ack)
+{
+    if (operatorSerialPort) {
+        serialWriteBuf(operatorSerialPort, (const uint8_t *)ack, 3);
+    }
+}
+
+// Завершает HID tap, сохраняя каждый отчёт до нескольких циклов опроса хоста.
+static void operatorServiceKey(void)
+{
+    if (operatorKeyState == OPERATOR_KEY_IDLE || (int32_t)(millis() - operatorKeyDeadline) < 0) {
+        return;
+    }
+
+    if (operatorKeyState == OPERATOR_KEY_PRESSED) {
+        memset(operatorKeyboardReport, 0, sizeof(operatorKeyboardReport));
+        sendReport(operatorKeyboardReport, sizeof(operatorKeyboardReport));
+        operatorKeyState = OPERATOR_KEY_RELEASED;
+        operatorKeyDeadline = millis() + OPERATOR_REPORT_HOLD_MS;
+        return;
+    }
+
+    operatorKeyState = OPERATOR_KEY_IDLE;
+    operatorSendAck("ACK");
+}
+
+// Принимает только кадр A5, modifier, HID usage, XOR checksum; произвольный ввод запрещён.
+static void operatorConsumeByte(uint8_t value)
+{
+    if (operatorFrameLength == 0 && value != OPERATOR_FRAME_MAGIC) {
+        return;
+    }
+    operatorFrame[operatorFrameLength++] = value;
+    if (operatorFrameLength < OPERATOR_FRAME_SIZE) {
+        return;
+    }
+    operatorFrameLength = 0;
+
+    const uint8_t modifier = operatorFrame[1];
+    const uint8_t key = operatorFrame[2];
+    const uint8_t checksum = operatorFrame[0] ^ modifier ^ key;
+    if (operatorFrame[0] != OPERATOR_FRAME_MAGIC || checksum != operatorFrame[3] ||
+        (modifier & ~OPERATOR_MODIFIERS_ALLOWED) != 0 ||
+        key < OPERATOR_KEY_MIN || key > OPERATOR_KEY_MAX || operatorKeyState != OPERATOR_KEY_IDLE) {
+        operatorSendAck("ERR");
+        return;
+    }
+
+    memset(operatorKeyboardReport, 0, sizeof(operatorKeyboardReport));
+    operatorKeyboardReport[0] = modifier;
+    operatorKeyboardReport[2] = key;
+    sendReport(operatorKeyboardReport, sizeof(operatorKeyboardReport));
+    operatorKeyState = OPERATOR_KEY_PRESSED;
+    operatorKeyDeadline = millis() + OPERATOR_REPORT_HOLD_MS;
+}
+
+// Читает UART4, выдерживает нажатие и отпускание, затем подтверждает tap.
+void sendRcDataToHid(void)
+{
+    if (!usbIsConnected()) {
+        if (operatorKeyState != OPERATOR_KEY_IDLE) {
+            memset(operatorKeyboardReport, 0, sizeof(operatorKeyboardReport));
+            operatorKeyState = OPERATOR_KEY_IDLE;
+            operatorSendAck("ERR");
+        }
+        operatorFrameLength = 0;
+        return;
+    }
+    if (!operatorSerialPort) {
+        operatorSerialPort = openSerialPort(SERIAL_PORT_UART4, FUNCTION_NONE, NULL, NULL, 115200, MODE_RXTX, SERIAL_NOT_INVERTED);
+        if (!operatorSerialPort) {
+            return;
+        }
+    }
+    operatorServiceKey();
+    if (ARMING_FLAG(ARMED)) {
+        bool commandDiscarded = false;
+        while (serialRxBytesWaiting(operatorSerialPort)) {
+            (void)serialRead(operatorSerialPort);
+            commandDiscarded = true;
+        }
+        operatorFrameLength = 0;
+        if (commandDiscarded) {
+            operatorSendAck("ARM");
+        }
+        return;
+    }
+    while (operatorKeyState == OPERATOR_KEY_IDLE && serialRxBytesWaiting(operatorSerialPort)) {
+        operatorConsumeByte(serialRead(operatorSerialPort));
+    }
+}
+#else
 void sendRcDataToHid(void)
 {
     int8_t report[9];
@@ -85,6 +211,8 @@ void sendRcDataToHid(void)
     sendReport((uint8_t*)report, sizeof(report));
 }
 
+#endif
