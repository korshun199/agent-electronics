+#ifdef USE_MASHA_OPERATOR_KEYBOARD
+#define OPERATOR_KEY_FRAME_SIZE 4
+#define OPERATOR_MOUSE_FRAME_SIZE 6
+#define OPERATOR_FRAME_MAGIC_KEY 0xA5
+#define OPERATOR_FRAME_MAGIC_MOUSE 0xA6
+#define OPERATOR_KEY_MIN 0x04
+#define OPERATOR_KEY_MAX 0x38
+#define OPERATOR_MODIFIERS_ALLOWED 0x07
+#define OPERATOR_MOUSE_BUTTONS_ALLOWED 0x07
+#define OPERATOR_REPORT_HOLD_MS 30
+#define OPERATOR_KEYBOARD_REPORT_ID 0x01
+#define OPERATOR_MOUSE_REPORT_ID 0x02
+#define OPERATOR_REPORT_MAX_SIZE 9
+
+typedef enum {
+    OPERATOR_REPORT_IDLE = 0,
+    OPERATOR_REPORT_PRESSED,
+    OPERATOR_REPORT_RELEASED
+} operatorReportState_e;
+
+typedef enum {
+    OPERATOR_REPORT_KEYBOARD = 0,
+    OPERATOR_REPORT_MOUSE
+} operatorReportType_e;
+
+static serialPort_t *operatorSerialPort;
+static uint8_t operatorFrame[OPERATOR_MOUSE_FRAME_SIZE];
+static uint8_t operatorFrameLength;
+static uint8_t operatorFrameExpectedLength;
+static uint8_t operatorReport[OPERATOR_REPORT_MAX_SIZE];
+static uint8_t operatorReleaseReport[OPERATOR_REPORT_MAX_SIZE];
+static uint8_t operatorReportLength;
+static operatorReportState_e operatorReportState;
+static operatorReportType_e operatorReportType;
+static timeMs_t operatorReportDeadline;
+
+static void operatorSendAck(const char *ack)
+{
+    if (operatorSerialPort) {
+        serialWriteBuf(operatorSerialPort, (const uint8_t *)ack, 3);
+    }
+}
+
+static void operatorBeginReport(operatorReportType_e type, uint8_t length)
+{
+    operatorReportType = type;
+    operatorReportLength = length;
+    memset(operatorReleaseReport, 0, sizeof(operatorReleaseReport));
+    operatorReleaseReport[0] = type == OPERATOR_REPORT_KEYBOARD ? OPERATOR_KEYBOARD_REPORT_ID : OPERATOR_MOUSE_REPORT_ID;
+    sendReport(operatorReport, operatorReportLength);
+    operatorReportState = OPERATOR_REPORT_PRESSED;
+    operatorReportDeadline = millis() + OPERATOR_REPORT_HOLD_MS;
+}
+
+static void operatorServiceReport(void)
+{
+    if (operatorReportState == OPERATOR_REPORT_IDLE || (int32_t)(millis() - operatorReportDeadline) < 0) {
+        return;
+    }
+
+    if (operatorReportState == OPERATOR_REPORT_PRESSED) {
+        sendReport(operatorReleaseReport, operatorReportLength);
+        operatorReportState = OPERATOR_REPORT_RELEASED;
+        operatorReportDeadline = millis() + OPERATOR_REPORT_HOLD_MS;
+        return;
+    }
+
+    operatorReportState = OPERATOR_REPORT_IDLE;
+    operatorSendAck("ACK");
+}
+
+static void operatorConsumeKeyFrame(void)
+{
+    const uint8_t modifier = operatorFrame[1];
+    const uint8_t key = operatorFrame[2];
+    const uint8_t checksum = operatorFrame[0] ^ modifier ^ key;
+    if (checksum != operatorFrame[3] || (modifier & ~OPERATOR_MODIFIERS_ALLOWED) != 0 ||
+        key < OPERATOR_KEY_MIN || key > OPERATOR_KEY_MAX || operatorReportState != OPERATOR_REPORT_IDLE) {
+        operatorSendAck("ERR");
+        return;
+    }
+
+    memset(operatorReport, 0, sizeof(operatorReport));
+    operatorReport[0] = OPERATOR_KEYBOARD_REPORT_ID;
+    operatorReport[1] = modifier;
+    operatorReport[3] = key;
+    operatorBeginReport(OPERATOR_REPORT_KEYBOARD, 9);
+}
+
+static void operatorConsumeMouseFrame(void)
+{
+    const uint8_t buttons = operatorFrame[1];
+    const int8_t deltaX = (int8_t)operatorFrame[2];
+    const int8_t deltaY = (int8_t)operatorFrame[3];
+    const int8_t wheel = (int8_t)operatorFrame[4];
+    const uint8_t checksum = operatorFrame[0] ^ buttons ^ operatorFrame[2] ^ operatorFrame[3] ^ operatorFrame[4];
+    if (checksum != operatorFrame[5] || (buttons & ~OPERATOR_MOUSE_BUTTONS_ALLOWED) != 0 ||
+        deltaX == INT8_MIN || deltaY == INT8_MIN || wheel == INT8_MIN ||
+        (buttons == 0 && deltaX == 0 && deltaY == 0 && wheel == 0) ||
+        operatorReportState != OPERATOR_REPORT_IDLE) {
+        operatorSendAck("ERR");
+        return;
+    }
+
+    memset(operatorReport, 0, sizeof(operatorReport));
+    operatorReport[0] = OPERATOR_MOUSE_REPORT_ID;
+    operatorReport[1] = buttons;
+    operatorReport[2] = (uint8_t)deltaX;
+    operatorReport[3] = (uint8_t)deltaY;
+    operatorReport[4] = (uint8_t)wheel;
+    operatorBeginReport(OPERATOR_REPORT_MOUSE, 5);
+}
+
+static void operatorConsumeByte(uint8_t value)
+{
+    if (operatorFrameLength == 0) {
+        if (value == OPERATOR_FRAME_MAGIC_KEY) {
+            operatorFrameExpectedLength = OPERATOR_KEY_FRAME_SIZE;
+        } else if (value == OPERATOR_FRAME_MAGIC_MOUSE) {
+            operatorFrameExpectedLength = OPERATOR_MOUSE_FRAME_SIZE;
+        } else {
+            return;
+        }
+    }
+
+    operatorFrame[operatorFrameLength++] = value;
+    if (operatorFrameLength < operatorFrameExpectedLength) {
+        return;
+    }
+
+    const uint8_t frameType = operatorFrame[0];
+    operatorFrameLength = 0;
+    operatorFrameExpectedLength = 0;
+    if (frameType == OPERATOR_FRAME_MAGIC_KEY) {
+        operatorConsumeKeyFrame();
+    } else {
+        operatorConsumeMouseFrame();
+    }
+}
+
+void sendRcDataToHid(void)
+{
+    if (!usbIsConnected()) {
+        if (operatorReportState != OPERATOR_REPORT_IDLE) {
+            operatorReportState = OPERATOR_REPORT_IDLE;
+            operatorSendAck("ERR");
+        }
+        operatorFrameLength = 0;
+        operatorFrameExpectedLength = 0;
+        return;
+    }
+    if (!operatorSerialPort) {
+        operatorSerialPort = openSerialPort(SERIAL_PORT_UART4, FUNCTION_NONE, NULL, NULL, 115200, MODE_RXTX, SERIAL_NOT_INVERTED);
+        if (!operatorSerialPort) {
+            return;
+        }
+    }
+    operatorServiceReport();
+    if (ARMING_FLAG(ARMED)) {
+        bool commandDiscarded = false;
+        while (serialRxBytesWaiting(operatorSerialPort)) {
+            (void)serialRead(operatorSerialPort);
+            commandDiscarded = true;
+        }
+        operatorFrameLength = 0;
+        operatorFrameExpectedLength = 0;
+        if (commandDiscarded) {
+            operatorSendAck("ARM");
+        }
+        return;
+    }
+    while (operatorReportState == OPERATOR_REPORT_IDLE && serialRxBytesWaiting(operatorSerialPort)) {
+        operatorConsumeByte(serialRead(operatorSerialPort));
+    }
+}
